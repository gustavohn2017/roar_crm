from django.shortcuts import redirect
from django.contrib import messages
from django.urls import resolve


class RestricaoHistoricoMiddleware:
    """
    Middleware para restringir o acesso de vendedores ao histï¿½rico de contatos
    e ao painel administrativo do Django
    """
    def __init__(self, get_response):
        self.get_response = get_response
        
    def __call__(self, request):
        if request.user.is_authenticated:
            # Verifica se o usuï¿½rio tem perfil (para evitar erros com usuï¿½rios antigos)
            hasattr_profile = hasattr(request.user, "profile")
            is_supervisor = hasattr_profile and request.user.profile.role == "supervisor"
            
            # Somente aplica restriï¿½ï¿½es para usuï¿½rios que nï¿½o sï¿½o staff (admins) nem supervisores
            if not request.user.is_staff and not is_supervisor:
                try:
                    current_url = resolve(request.path_info)
                    
                    # Impedir acesso ï¿½ view de histï¿½rico de contatos
                    if current_url.url_name == "historico_contatos":
                        messages.warning(request, "Acesso ao histï¿½rico de contatos restrito.")
                        return redirect("dashboard_vendedor")
                except:
                    pass
                    
                # Impedir acesso ao painel administrativo do Django
                if request.path.startswith("/admin/"):
                    messages.warning(request, "Acesso restrito. Vocï¿½ nï¿½o tem permissï¿½o para acessar o painel administrativo.")
                    return redirect("dashboard_vendedor")

        response = self.get_response(request)
        
        # Remover botï¿½o/link para o painel administrativo se o usuï¿½rio nï¿½o for staff e nem supervisor
        if request.user.is_authenticated:
            hasattr_profile = hasattr(request.user, "profile")
            is_supervisor = hasattr_profile and request.user.profile.role == "supervisor"
            
            if not request.user.is_staff and not is_supervisor and "text/html" in response.get("Content-Type", ""):
                if hasattr(response, "content"):
                    # Converte para string se for bytes
                    content = response.content.decode("utf-8") if isinstance(response.content, bytes) else response.content
                    
                    # Remove links para o admin nas pï¿½ginas HTML
                    content = content.replace("<a href=\"/admin/\"", "<a style=\"display:none\" href=\"#\"")
                    content = content.replace("<a href=\"/admin\"", "<a style=\"display:none\" href=\"#\"")
                    
                    # Converte de volta para bytes se necessï¿½rio
                    if isinstance(response.content, bytes):
                        response.content = content.encode("utf-8")
                    else:
                        response.content = content
                    
        return response
